    "Auto: controllers with a web interface (Unico: VX Pro, COEX) get the layout over REST and store it themselves; other sending cards get it over TCP 5200 without saving." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Авто: контроллеры с веб-интерфейсом (Unico: VX Pro, COEX) получают раскладку через REST и сохраняют её сами; остальные отправляющие карты — через TCP 5200 без сохранения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动：带网页界面的控制器（Unico：VX Pro、COEX）通过 REST 接收布局并自行保存；其他发送卡通过 TCP 5200 接收，不保存。"
          }
        }
      }
    },
    "Back to rows × columns grid" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вернуть сетку строки × столбцы"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复为行 × 列网格"
          }
        }
      }
    },
    "Basic Information" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Основные сведения"
